PORT=5000
JWT_SECRET=change-this-to-a-long-random-string

# Optional — uses local JSON files in server/data/ if unset (not suitable for cloud deploy)
MONGODB_URI=

# Google Gemini (AI chatbot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cloudinary (image uploads) — optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase storage — optional alternative to Cloudinary
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Netlify frontend URL (for CORS), e.g. https://your-site.netlify.app
CLIENT_URL=
